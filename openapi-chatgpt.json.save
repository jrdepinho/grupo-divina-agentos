  "openapi": "3.1.0",
  "info": {
    "title": "Agente Divina Runtime",
    "description": "Runtime universal do Agente Divina.",
    "version": "2.0.0"
  },
  "servers":
    {
      "url": "https://agente.divinahomepy.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Servidor online",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/execute": {
      "post": {
        "operationId": "runtime_execute",
        "summary": "Executa uma operação do runtime",
        "requestBody": {
          "requitrue,
