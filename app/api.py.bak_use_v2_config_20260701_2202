def verificar_token(authorization: str | None):
    print(f"AUTH_DIAG verificar_token authorization_present={bool(authorization)}", flush=True)
    config_api = dotenv_values("/opt/agente-divina/config/api.env")
    API_TOKEN = config_api.get("AGENTE_API_TOKEN")
    if not API_TOKEN:
        raise HTTPException(status_code=500, detail="API token não configurado")
    if not authorization or not authorization.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Token ausente")
    token = authorization.replace("Bearer ", "").strip()
    if token != API_TOKEN:
        raise HTTPException(status_code=403, detail="Token inválido")

def run_cmd(cmd):
    result = subprocess.run(
        cmd,
        shell=True,
        cwd="/opt/agente-divina/app",
        executable="/bin/bash",
        capture_output=True,
        text=True,
        timeout=300
    )
    return {"ok": result.returncode == 0, "stdout": result.stdout, "stderr": result.stderr}

