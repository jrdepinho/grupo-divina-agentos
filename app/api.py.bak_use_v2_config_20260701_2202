@app.post("/admin/list-files")
def admin_list_files(payload: AdminListFilesRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    from pathlib import Path

    base = Path(str(payload.path)).resolve()
    pattern = str(payload.pattern)
    max_items = int(payload.max_items)

    allowed_roots = [
        Path("/opt/grupo-divina-dashboard").resolve(),
        Path("/opt/agente-divina").resolve(),
        Path("/opt/agente-fornecedores").resolve(),
    ]

    if not any(str(base).startswith(str(root)) for root in allowed_roots):
        return {"ok": False, "erro": "Diretório fora dos permitidos", "path": str(base)}

    if not base.exists() or not base.is_dir():
        return {"ok": False, "erro": "Diretório não encontrado", "path": str(base)}

    items = []
    for p in base.rglob(pattern):
        if len(items) >= max_items:
            break
        items.append({
            "path": str(p),
            "type": "dir" if p.is_dir() else "file",
            "size": p.stat().st_size if p.is_file() else None
        })

    return {
        "ok": True,
        "base": str(base),
        "pattern": pattern,
        "count": len(items),
        "items": items
    }

@app.post("/admin/git")
def admin_git(payload: AdminGitRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    import subprocess

    action = str(payload.action).strip()
    message = str(payload.message).strip()
    cwd = str(payload.cwd).strip()

    allowed_cwd = [
        "/opt/grupo-divina-dashboard",
        "/opt/agente-divina",
        "/opt/agente-fornecedores",
    ]

    if cwd not in allowed_cwd:
        return {"ok": False, "erro": "cwd não permitido", "cwd": cwd}

    comandos = {
        "status": "git status",
        "pull": "git pull --rebase origin main",
        "diff": "git diff",
        "log": "git log --oneline -10",
        "push": "git push origin main",
    }

    if action == "commit":
        if not message:
            return {"ok": False, "erro": "message obrigatório para commit"}
        cmd = f'git add . && git commit -m "{message}"'
    elif action == "sync":
        if not message:
            return {"ok": False, "erro": "message obrigatório para sync"}
        cmd = f'git pull --rebase origin main && git add . && git commit -m "{message}" && git push origin main'
    elif action in comandos:
        cmd = comandos[action]
    else:
        return {"ok": False, "erro": "action inválida", "actions": ["status", "pull", "diff", "log", "commit", "push", "sync"]}

    proc = subprocess.run(
        cmd,
        shell=True,
        cwd=cwd,
        capture_output=True,
        text=True,
        timeout=180
    )

    return {
        "ok": proc.returncode == 0,
        "action": action,
        "cmd": cmd,
        "cwd": cwd,
        "exit_code": proc.returncode,
        "stdout": proc.stdout[-12000:],
        "stderr": proc.stderr[-12000:]
    }

@app.post("/admin/supabase-query")
def admin_supabase_query(payload: AdminSupabaseQueryRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    import os
    import psycopg2
    import psycopg2.extras

    sql = str(payload.sql).strip()
    params = payload.params

    if not sql.lower().startswith("select"):
        return {"ok": False, "erro": "Apenas SELECT permitido neste endpoint"}

    proibidos = ["insert ", "update ", "delete ", "drop ", "alter ", "truncate ", "create ", "grant ", "revoke "]
    if any(p in sql.lower() for p in proibidos):
        return {"ok": False, "erro": "Comando SQL não permitido"}

    conn_str = os.getenv("SUPABASE_DB_URL")
    if not conn_str:
        return {"ok": False, "erro": "SUPABASE_DB_URL não configurado no ambiente do agente"}

    try:
        with psycopg2.connect(conn_str) as conn:
            with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
                cur.execute(sql, params)
                rows = cur.fetchall()

        return {
            "ok": True,
            "count": len(rows),
            "rows": rows[:500]
        }
    except Exception as e:
        return {"ok": False, "erro": str(e)}


@app.post("/erp/sync-metadata")
def erp_sync_metadata(payload: SyncMetadataRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    import os
    import time
    import psycopg2
    import psycopg2.extras

    schema = str(payload.schema_name or "public")
    batch_size = int(payload.batch_size or 20)
    if batch_size < 1:
        batch_size = 20
    if batch_size > 100:
        batch_size = 100

    conn_str = os.getenv("SUPABASE_DB_URL")
    if not conn_str:
        return {"ok": False, "erro": "SUPABASE_DB_URL não configurado no ambiente do agente"}

    started = time.time()
    result = {
        "ok": True,
        "schema": schema,
        "batch_size": batch_size,
        "processed_tables": 0,
        "processed_columns": 0,
        "processed_relationships": 0,
        "errors": []
    }

    try:
        conn = psycopg2.connect(conn_str)
        conn.autocommit = False

        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            # List tables/views
            cur.execute(
                """
                SELECT table_schema, table_name, table_type
                FROM information_schema.tables
                WHERE table_schema = %s
                  AND table_type IN ('BASE TABLE', 'VIEW')
                ORDER BY table_name
                """,
                (schema,)
            )
            tables = cur.fetchall()

        # Sync tables in batches
        for i in range(0, len(tables), batch_size):
            batch = tables[i:i + batch_size]
            with conn.cursor() as cur:
                for row in batch:
                    table_name = row["table_name"]
                    module_name = "Geral"
                    if "xml" in table_name or "fiscal" in table_name or "nfe" in table_name:
                        module_name = "Fiscal / XML"
                    elif "contas_pagar" in table_name or "pagar" in table_name or "financeira" in table_name or "banc" in table_name or "caixa" in table_name:
                        module_name = "Financeiro"
                    elif "compra" in table_name or "fornecedor" in table_name:
                        module_name = "Compras"
                    elif "estoque" in table_name or "produto" in table_name:
                        module_name = "Estoque / Produtos"
                    elif "producao" in table_name:
                        module_name = "Produção"
                    elif "venda" in table_name or "cliente" in table_name:
                        module_name = "Comercial"
                    elif "pessoa" in table_name or "parceiro" in table_name:
                        module_name = "Pessoas / Parceiros"
                    elif table_name.startswith("vw_"):
                        module_name = "Dashboards / Views"

                    cur.execute(
                        """
                        INSERT INTO public.erp_metadata_tables
                          (schema_name, table_name, module_name, business_name, description, criticality, source_type)
                        VALUES
                          (%s, %s, %s, initcap(replace(%s, '_', ' ')), %s, 'medium', 'catalog_auto')
                        ON CONFLICT (schema_name, table_name)
                        DO UPDATE SET
                          module_name = EXCLUDED.module_name,
                          updated_at = now()
                        """,
                        (schema, table_name, module_name, table_name, "Metadado técnico importado automaticamente do catálogo PostgreSQL.")
                    )
                    result["processed_tables"] += 1
            conn.commit()

        # Load PK columns
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute(
                """
                SELECT kcu.table_schema, kcu.table_name, kcu.column_name
                FROM information_schema.table_constraints tc
                JOIN information_schema.key_column_usage kcu
                  ON tc.constraint_name = kcu.constraint_name
                 AND tc.table_schema = kcu.table_schema
                 AND tc.table_name = kcu.table_name
                WHERE tc.constraint_type = 'PRIMARY KEY'
                  AND tc.table_schema = %s
                """,
                (schema,)
            )
            pk_set = {(r["table_name"], r["column_name"]) for r in cur.fetchall()}

            cur.execute(
                """
                SELECT kcu.table_schema, kcu.table_name, kcu.column_name
                FROM information_schema.table_constraints tc
                JOIN information_schema.key_column_usage kcu
                  ON tc.constraint_name = kcu.constraint_name
                 AND tc.table_schema = kcu.table_schema
                 AND tc.table_name = kcu.table_name
                WHERE tc.constraint_type = 'FOREIGN KEY'
                  AND tc.table_schema = %s
                """,
                (schema,)
            )
            fk_col_set = {(r["table_name"], r["column_name"]) for r in cur.fetchall()}

            cur.execute(
                """
                SELECT c.table_schema, c.table_name, c.column_name, c.data_type,
                       c.character_maximum_length, c.numeric_precision, c.numeric_scale,
                       c.is_nullable
                FROM information_schema.columns c
                WHERE c.table_schema = %s
                ORDER BY c.table_name, c.ordinal_position
                """,
                (schema,)
            )
            columns = cur.fetchall()

        # Sync columns in batches
        for i in range(0, len(columns), batch_size):
            batch = columns[i:i + batch_size]
            with conn.cursor() as cur:
                for c in batch:
                    if c["character_maximum_length"] is not None:
                        data_type = f'{c["data_type"]}({c["character_maximum_length"]})'
                    elif c["numeric_precision"] is not None and c["numeric_scale"] is not None:
                        data_type = f'{c["data_type"]}({c["numeric_precision"]},{c["numeric_scale"]})'
                    else:
                        data_type = c["data_type"]

                    cur.execute(
                        """
                        SELECT id FROM public.erp_metadata_tables
                        WHERE schema_name = %s AND table_name = %s
                        """,
                        (schema, c["table_name"])
                    )
                    mt = cur.fetchone()
                    table_metadata_id = mt[0] if mt else None

                    cur.execute(
                        """
                        INSERT INTO public.erp_metadata_columns
                          (table_metadata_id, schema_name, table_name, column_name, data_type,
                           business_name, description, is_required, is_primary_key, is_foreign_key)
                        VALUES
                          (%s, %s, %s, %s, %s, initcap(replace(%s, '_', ' ')), %s, %s, %s, %s)
                        ON CONFLICT (schema_name, table_name, column_name)
                        DO UPDATE SET
                          table_metadata_id = EXCLUDED.table_metadata_id,
                          data_type = EXCLUDED.data_type,
                          is_required = EXCLUDED.is_required,
                          is_primary_key = EXCLUDED.is_primary_key,
                          is_foreign_key = EXCLUDED.is_foreign_key,
                          updated_at = now()
                        """,
                        (
                            table_metadata_id, schema, c["table_name"], c["column_name"], data_type,
                            c["column_name"], "Coluna importada automaticamente do catálogo PostgreSQL.",
                            c["is_nullable"] == "NO",
                            (c["table_name"], c["column_name"]) in pk_set,
                            (c["table_name"], c["column_name"]) in fk_col_set
                        )
                    )
                    result["processed_columns"] += 1
            conn.commit()

        # Load relationships
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute(
                """
                SELECT kcu.table_schema AS source_schema,
                       kcu.table_name AS source_table,
                       kcu.column_name AS source_column,
                       ccu.table_schema AS target_schema,
                       ccu.table_name AS target_table,
                       ccu.column_name AS target_column
                FROM information_schema.table_constraints tc
                JOIN information_schema.key_column_usage kcu
                  ON tc.constraint_name = kcu.constraint_name
                 AND tc.table_schema = kcu.table_schema
                 AND tc.table_name = kcu.table_name
                JOIN information_schema.constraint_column_usage ccu
                  ON ccu.constraint_name = tc.constraint_name
                 AND ccu.table_schema = tc.table_schema
                WHERE tc.constraint_type = 'FOREIGN KEY'
                  AND kcu.table_schema = %s
                ORDER BY kcu.table_name, kcu.column_name
                """,
                (schema,)
            )
            relationships = cur.fetchall()

        for i in range(0, len(relationships), batch_size):
            batch = relationships[i:i + batch_size]
            with conn.cursor() as cur:
                for r in batch:
                    cur.execute(
                        """
                        INSERT INTO public.erp_relationships
                          (source_schema, source_table, source_column,
                           target_schema, target_table, target_column,
                           relationship_type, business_description, confidence)
                        VALUES
                          (%s, %s, %s, %s, %s, %s, 'many_to_one', %s, 'catalog_fk')
                        ON CONFLICT (source_schema, source_table, source_column, target_schema, target_table, target_column)
                        DO UPDATE SET
                          relationship_type = EXCLUDED.relationship_type,
                          business_description = EXCLUDED.business_description,
                          confidence = EXCLUDED.confidence
                        """,
                        (
                            r["source_schema"], r["source_table"], r["source_column"],
                            r["target_schema"], r["target_table"], r["target_column"],
                            "Relacionamento técnico importado automaticamente de chave estrangeira."
                        )
                    )
                    result["processed_relationships"] += 1
            conn.commit()

        conn.close()
        result["duration_seconds"] = round(time.time() - started, 2)
        return result

    except Exception as e:
        try:
            conn.rollback()
            conn.close()
        except Exception:
            pass
        result["ok"] = False
        result["errors"].append(str(e))
        result["duration_seconds"] = round(time.time() - started, 2)
        return result


@app.post("/admin/patch-file")
def admin_patch_file(payload: AdminPatchFileRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    import shutil
    import time
    from pathlib import Path

    allowed_roots = [
        Path("/opt/agente-divina/app").resolve(),
        Path("/opt/agente-divina/config").resolve(),
        Path("/opt/grupo-divina-dashboard").resolve(),
        Path("/opt/agente-fornecedores").resolve(),
    ]

    file_path = Path(str(payload.file)).resolve()
    search = payload.search
    replace = payload.replace
    compile_python = bool(payload.compile_python)

    if not str(file_path):
        return {"ok": False, "erro": "file obrigatório"}
    if search is None or replace is None:
        return {"ok": False, "erro": "search e replace são obrigatórios"}
    if not any(str(file_path).startswith(str(root)) for root in allowed_roots):
        return {"ok": False, "erro": "arquivo fora dos diretórios permitidos", "file": str(file_path)}
    if not file_path.exists() or not file_path.is_file():
        return {"ok": False, "erro": "arquivo não encontrado", "file": str(file_path)}

    text = file_path.read_text()
    occurrences = text.count(str(search))
    if occurrences == 0:
        return {"ok": False, "erro": "trecho search não encontrado", "file": str(file_path)}

    backup = file_path.with_name(file_path.name + f".bak_patch_{int(time.time())}")
    shutil.copy2(file_path, backup)
    new_text = text.replace(str(search), str(replace), 1)
    file_path.write_text(new_text)

    compile_result = None
    if compile_python and file_path.suffix == ".py":
        import subprocess
        proc = subprocess.run(
            ["/opt/agente-divina/app/venv/bin/python", "-m", "py_compile", str(file_path)],
            capture_output=True,
            text=True,
            timeout=60,
        )
        compile_result = {
            "ok": proc.returncode == 0,
            "stdout": proc.stdout,
            "stderr": proc.stderr,
            "exit_code": proc.returncode,
        }
        if proc.returncode != 0:
            shutil.copy2(backup, file_path)
            return {
                "ok": False,
                "erro": "compilação falhou; arquivo restaurado do backup",
                "backup": str(backup),
                "compile": compile_result,
            }

    return {
        "ok": True,
        "file": str(file_path),
        "backup": str(backup),
        "occurrences_before": occurrences,
        "replaced": 1,
        "compile": compile_result,
    }

@app.post("/admin/restart-service")
def admin_restart_service(payload: AdminRestartServiceRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    import subprocess
    import time

    service = str(payload.service)
    allowed = {"agente-divina-api.service", "nginx"}
    if service not in allowed:
        return {"ok": False, "erro": "serviço não permitido", "allowed": sorted(allowed)}

    proc = subprocess.run(
        ["systemctl", "restart", service],
        capture_output=True,
        text=True,
        timeout=120,
    )
    time.sleep(2)
    status = subprocess.run(
        ["systemctl", "is-active", service],
        capture_output=True,
        text=True,
        timeout=20,
    )

    return {
        "ok": proc.returncode == 0 and status.stdout.strip() == "active",
        "service": service,
        "restart_exit_code": proc.returncode,
        "restart_stdout": proc.stdout,
        "restart_stderr": proc.stderr,
        "status": status.stdout.strip(),
        "status_stderr": status.stderr,
    }
