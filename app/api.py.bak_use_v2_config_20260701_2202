def admin_read_file(payload: AdminReadFileRequest, authorization: str | None = Header(default=None)):
    verificar_token(authorization)

    from pathlib import Path

    path = Path(str(payload.path)).resolve()

    allowed_roots = [
        Path("/opt/grupo-divina-dashboard").resolve(),
        Path("/opt/agente-divina").resolve(),
        Path("/opt/agente-fornecedores").resolve(),
    ]

    if not any(str(path).startswith(str(root)) for root in allowed_roots):
