def _write_plan_audit(plan_name: str, report: dict[str, Any]) -> str:
    path = AUDIT_DIR / f"{plan_name}-{_now()}.json"
    path.write_text(json.dumps(report, ensure_ascii=False, indent=2, default=str), encoding="utf-8")
    return str(path)

def handle_execute_plan_op(
    req: Any,
    safe_path: Callable[[str], Path],
    run_cmd: Callable[..., dict[str, Any]],
) -> dict[str, Any] | None:
    if req.operation not in {"execute_plan", "execute_plan_v2"}:
        return None

    args = req.args or {}
    plan_name = args.get("plan") or req.content or "custom"
    cwd = args.get("cwd") or "/opt/grupo-divina-dashboard"
    stop_on_error = bool(args.get("stop_on_error", True))
    rollback_on_error = bool(args.get("rollback_on_error", True))
    steps = args.get("steps") or _preset_steps(str(plan_name))

    if not isinstance(steps, list):
        raise HTTPException(400, "args.steps deve ser uma lista")

    backups: list[dict[str, str | None]] = []
    report_steps: list[dict[str, Any]] = []

    def fail(step_report: dict[str, Any]) -> dict[str, Any]:
        restored = _restore(backups) if rollback_on_error else []
        report = {
            "ok": False,
            "plan": plan_name,
            "stopped_at": step_report.get("step"),
            "rollback_executed": rollback_on_error,
            "restored": restored,
            "steps": report_steps,
        }
        report["audit_path"] = _write_plan_audit(str(plan_name), report)
        return report

    for index, step in enumerate(steps, start=1):
        if not isinstance(step, dict):
            step_report = {"index": index, "ok": False, "error": "step inválido"}
            report_steps.append(step_report)
            if stop_on_error:
                return fail(step_report)
            continue

        action = str(step.get("action") or "").strip()
        step_report: dict[str, Any] = {"index": index, "step": action, "ok": True}

        try:
            if action == "mkdir":
                p = safe_path(str(step.get("path") or ""))
                existed = p.exists()
                backups.append({"target": str(p), "backup": None, "existed": existed})
                p.mkdir(parents=True, exist_ok=True)
                step_report["path"] = str(p)

            elif action == "write_file":
                p = safe_path(str(step.get("path") or ""))
                existed = p.exists()
                backup = _backup(p)
                backups.append({"target": str(p), "backup": str(backup) if backup else None, "existed": existed})
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(str(step.get("content") or ""))
                step_report["path"] = str(p)
                step_report["backup"] = str(backup) if backup else None

            elif action == "patch_file":
                p = safe_path(str(step.get("path") or ""))
                find = str(step.get("find") or "")
                replace = str(step.get("replace") or "")
                if not find:
                    raise HTTPException(400, "find obrigatório")
                text = p.read_text(errors="replace")
                if find not in text:
                    raise HTTPException(404, f"trecho não encontrado em {p}")
                backup = _backup(p)
                backups.append({"target": str(p), "backup": str(backup) if backup else None, "existed": True})
                p.write_text(text.replace(find, replace, int(step.get("count") or 1)))
                step_report["path"] = str(p)
                step_report["backup"] = str(backup) if backup else None

            elif action == "delete_file":
                p = safe_path(str(step.get("path") or ""))
                existed = p.exists()
                backup = _backup(p)
                backups.append({"target": str(p), "backup": str(backup) if backup else None, "existed": existed})
                if p.exists():
                    if p.is_dir():
                        shutil.rmtree(p)
                    else:
                        p.unlink()
                step_report["path"] = str(p)

            elif action == "shell":
                cmd = str(step.get("command") or "")
                step_cwd = str(step.get("cwd") or cwd)
                result = run_cmd(cmd, cwd=step_cwd)
                step_report["result"] = result
                if result.get("returncode") != 0:
                    step_report["ok"] = False

            elif action == "py_compile":
                target = str(step.get("path") or ".")
                result = run_cmd(f"python3 -m py_compile {target}", cwd=cwd)
                step_report["result"] = result
                if result.get("returncode") != 0:
                    step_report["ok"] = False

            elif action == "build":
                result = run_cmd(str(step.get("command") or "npm run build"), cwd=str(step.get("cwd") or cwd))
                step_report["result"] = result
                if result.get("returncode") != 0:
                    step_report["ok"] = False

            elif action == "test":
                result = run_cmd(str(step.get("command") or "npm test -- --watch=false"), cwd=str(step.get("cwd") or cwd))
                step_report["result"] = result
                if result.get("returncode") != 0:
                    step_report["ok"] = False

            elif action == "git_status":
                step_report["result"] = run_cmd("git status --short", cwd=str(step.get("cwd") or cwd))

            elif action == "git_diff":
                step_report["result"] = run_cmd("git diff -- .", cwd=str(step.get("cwd") or cwd))

            elif action == "commit":
                message = str(step.get("message") or "chore: atualização operacional")
                files = str(step.get("files") or ".")
                result = run_cmd(f"git add {files} && git commit -m {message!r}", cwd=str(step.get("cwd") or cwd))
                step_report["result"] = result
                if result.get("returncode") not in (0, 1):
                    step_report["ok"] = False

            elif action == "push":
                branch = str(step.get("branch") or "main")
                result = run_cmd(f"git push origin {branch}", cwd=str(step.get("cwd") or cwd))
                step_report["result"] = result
                if result.get("returncode") != 0:
                    step_report["ok"] = False

            elif action == "healthcheck":
                url = str(step.get("url") or "https://grupo-divina-dashboard.vercel.app/auth/login")
                result = run_cmd(f"curl -s -I {url} | head -30", cwd=str(step.get("cwd") or cwd))
                step_report["result"] = result
                if result.get("returncode") != 0:
                    step_report["ok"] = False

            elif action == "smoke_test":
                smoke_req = SimpleNamespace(
                    operation="smoke_test",
                    args=step.get("args") or {},
                    path=None,
                    content=None,
                )
                result = handle_smoke_op(smoke_req, run_cmd)
                step_report["result"] = result
                if not result or not result.get("ok"):
                    step_report["ok"] = False

            elif action == "browser_flow":
                browser_args = dict(step.get("args") or {})
                if step.get("flow") and not browser_args.get("flow"):
                    browser_args["flow"] = step.get("flow")
                browser_req = SimpleNamespace(
                    operation="browser_flow",
                    args=browser_args,
                    path=step.get("url"),
                    content=step.get("flow"),
                )
                result = handle_browser_op(browser_req, run_cmd)
                step_report["result"] = result
                if not result or not result.get("ok"):
                    step_report["ok"] = False

            elif action == "browser_health":
                browser_req = SimpleNamespace(
                    operation="browser_health",
                    args=step.get("args") or {"url": step.get("url")},
                    path=step.get("url"),
                    content=None,
                )
                result = handle_browser_op(browser_req, run_cmd)
                step_report["result"] = result
                if not result or not result.get("ok"):
                    step_report["ok"] = False

            elif action == "browser_screenshot":
                browser_args = dict(step.get("args") or {})
                if step.get("url") and not browser_args.get("url"):
                    browser_args["url"] = step.get("url")
                if step.get("name") and not browser_args.get("name"):
                    browser_args["name"] = step.get("name")
                browser_req = SimpleNamespace(
                    operation="browser_screenshot",
                    args=browser_args,
                    path=step.get("url"),
                    content=None,
                )
                result = handle_browser_op(browser_req, run_cmd)
                step_report["result"] = result
                if not result or not result.get("ok"):
                    step_report["ok"] = False

            elif action == "service_restart":
                service = str(step.get("service") or "")
                allowed = {"agente-divina-api.service", "agente-divina-v2.service", "nginx.service"}
                if service not in allowed:
                    raise HTTPException(403, "serviço não permitido")
                result = run_cmd(f"systemctl restart {service}")
                step_report["result"] = result

            else:
                raise HTTPException(400, f"ação não suportada: {action}")

        except HTTPException as exc:
            step_report["ok"] = False
            step_report["error"] = exc.detail
        except Exception as exc:
            step_report["ok"] = False
            step_report["error"] = str(exc)

        report_steps.append(step_report)
        if not step_report.get("ok") and stop_on_error:
            return fail(step_report)

    report = {
        "ok": all(s.get("ok") for s in report_steps),
        "plan": plan_name,
        "rollback_executed": False,
        "backups": backups,
        "steps": report_steps,
    }
    report["audit_path"] = _write_plan_audit(str(plan_name), report)
    return report
