from app.routes.frontend_admin import router as frontend_admin_router
from app.routes.compact import router as compact_router
from app.routes.admin_full_access import router as admin_full_access_router



def _materialize_router(router) -> None:
    for route in router.routes:
        if isinstance(route, APIRoute):
            exists = any(
                isinstance(existing, APIRoute)
                and existing.path == route.path
                and existing.methods == route.methods
                for existing in app.router.routes
            )
            if not exists:
                app.router.routes.append(route)


# Replaces older legacy endpoints with the V2 implementations.

app.include_router(admin_secure_router)
app.include_router(admin_full_access_router)
app.include_router(deploy_secure_router)
app.include_router(plan_secure_router)
app.include_router(config_secure_router)
app.include_router(erp_router)
app.include_router(erp_security_router)
app.include_router(frontend_admin_router)
app.include_router(compact_router)
app.include_router(admin_full_access_router)
configure_openapi(app)

_materialize_router(admin_secure_router)
_materialize_router(deploy_secure_router)
_materialize_router(plan_secure_router)
_materialize_router(config_secure_router)
_materialize_router(erp_router)
_materialize_router(erp_security_router)
_materialize_router(frontend_admin_router)
_materialize_router(compact_router)
_materialize_router(admin_full_access_router)

app.openapi_schema = None
register_openapi_gpt(app)

