from __future__ import annotations

import os
from typing import Mapping

from dotenv import dotenv_values
from fastapi import HTTPException
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer


bearerAuth = HTTPBearer(scheme_name="bearerAuth", auto_error=False)

ADMIN_ENV_PATHS = (
    "/opt/agente-divina-v2/config/api.env",
    "/opt/agente-divina-v2/config/supabase.env",
    "/opt/agente-divina/config/api.env",
    "/opt/agente-divina/config/supabase.env",
)


def _read_env_file(path: str) -> Mapping[str, str | None]:
    try:
        return dotenv_values(path)
    except Exception:
        return {}


def get_admin_token() -> str | None:
    token = os.getenv("AGENTE_ADMIN_TOKEN")
    if token:
        return token

    for path in ADMIN_ENV_PATHS:
        token = _read_env_file(path).get("AGENTE_ADMIN_TOKEN")
        if token:
            return token

    return None


def authorization_header(
    credentials: HTTPAuthorizationCredentials | None,
) -> str | None:
    if credentials is None:
        return None
    return f"Bearer {credentials.credentials}"


def verify_admin_token(
    credentials: HTTPAuthorizationCredentials | None,
) -> None:
    admin_token = get_admin_token()
    if not admin_token:
        raise HTTPException(status_code=500, detail="AGENTE_ADMIN_TOKEN não configurado")

    authorization = authorization_header(credentials)
    if authorization != f"Bearer {admin_token}":
        raise HTTPException(status_code=401, detail="Unauthorized ADMIN ACCESS")


def verify_token(
    credentials: HTTPAuthorizationCredentials | None,
) -> None:
    """Compatibilidade temporária para rotas legadas."""
    verify_admin_token(credentials)

