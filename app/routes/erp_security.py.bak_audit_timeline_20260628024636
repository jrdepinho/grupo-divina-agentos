@router.post(
    "/erp/security",
    summary="Executar operação de segurança do ERP",
    description=(
        "Endpoint único para administrar segurança do ERP. Operações: summary, list_users, "
        "create_user, grant_company, list_access e roles."
    ),
)
def erp_security_execute(
    payload: SecurityExecuteRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    operation = str(payload.operation or "").strip().lower()
    data = payload.data or {}

    if operation == "summary":
        return erp_security_summary(credentials)

    if operation == "list_users":
        return erp_security_users_list(SecurityUserListRequest(**data), credentials)

    if operation == "create_user":
        return erp_security_users_create(SecurityUserCreateRequest(**data), credentials)

    if operation == "grant_company":
        return erp_security_grant_company(SecurityGrantCompanyRequest(**data), credentials)

    if operation == "list_access":
        return erp_security_access_list(SecurityAccessListRequest(**data), credentials)

    if operation == "roles":
        return erp_security_roles(credentials)

    if operation == "update_user":
        return erp_security_users_update(SecurityUserUpdateRequest(**data), credentials)

    if operation == "set_user_active":
        return erp_security_users_set_active(SecurityUserSetActiveRequest(**data), credentials)

    if operation == "revoke_company":
        return erp_security_revoke_company(SecurityAccessRevokeRequest(**data), credentials)

    if operation == "create_profile":
        return erp_security_profiles_create(SecurityProfileCreateRequest(**data), credentials)

    if operation == "update_profile":
        return erp_security_profiles_update(SecurityProfileUpdateRequest(**data), credentials)

    if operation == "set_profile_active":
        return erp_security_profiles_set_active(SecurityProfileSetActiveRequest(**data), credentials)

    raise HTTPException(
        status_code=400,
        detail={
            "erro": "operação não suportada",
            "operation": operation,
            "allowed": ["summary", "list_users", "create_user", "update_user", "set_user_active", "grant_company", "revoke_company", "list_access", "roles", "create_profile", "update_profile", "set_profile_active"],
        },
    )


@router.get("/erp/security/roles", summary="Listar perfis e permissões do ERP", operation_id="erp_security_roles_v1")
def erp_security_roles(
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    perfis = _query("select id, codigo, nome, descricao, ativo from public.erp_perfis order by nome")
    permissoes = _query("select codigo, modulo, acao, descricao, nivel_risco, altera_dados from public.erp_permissoes order by modulo, codigo")
    return {"ok": True, "perfis": perfis, "permissoes": permissoes}
