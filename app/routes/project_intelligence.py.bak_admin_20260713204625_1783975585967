@router.post("/goal")
def project_intelligence_goal(
    payload: GoalRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    plan = build_project_intelligence_plan(payload.goal, payload.path)
    if not plan["triggered"] or not payload.execute:
        _audit("project_intelligence.goal.plan", {"goal": payload.goal, "triggered": plan["triggered"]})
        return {"ok": True, "plan": plan, "executed": False}

    started = time.perf_counter()
    context = build_project_context(path=payload.path, module=plan.get("module"), max_files=payload.max_files)
    architecture = generate_architecture_from_context(context)
    duration_ms = round((time.perf_counter() - started) * 1000, 2)
    _audit("project_intelligence.context.build", _audit_payload("context.build", context, context.get("duration_ms", duration_ms)))
    _audit("project_intelligence.architecture.generate", _audit_payload("architecture.generate", architecture, architecture.get("duration_ms", duration_ms)))

    completed_plan = {
        **plan,
        "plan": [{**step, "status": "completed"} for step in plan["plan"]],
    }
    _audit(
        "project_intelligence.goal.execute",
        {
            "goal": payload.goal,
            "module": plan.get("module"),
            "capabilities": PROJECT_INTELLIGENCE_SEQUENCE,
        },
    )
    if payload.compact:
        pc = context.get("project_context", {}) or {}
        arch_json = architecture.get("json", {}) or {}
        summary = {
            "module": plan.get("module"),
            "root": pc.get("root"),
            "frontend": pc.get("frontend_frameworks"),
            "backend": pc.get("backend_frameworks"),
            "orm": pc.get("orm"),
            "counts": {
                "files": pc.get("files_analyzed"),
                "modules": len(pc.get("modules", []) or []),
                "endpoints": len(pc.get("endpoints", []) or []),
                "tables": len(pc.get("tables", []) or []),
            },
        }
        gaps = []
        gaps.extend(pc.get("incomplete_modules", []) or [])
        gaps.extend(pc.get("warnings", []) or [])
        gaps.extend(pc.get("errors", []) or [])
        if not pc.get("migrations"):
            gaps.append("No migrations detected")
        if not pc.get("git"):
            gaps.append("Git metadata unavailable")
        metrics = {
            "files_analyzed": pc.get("files_analyzed"),
            "modules_found": len(pc.get("modules", []) or []),
            "endpoints": len(pc.get("endpoints", []) or []),
            "tables": len(pc.get("tables", []) or []),
            "markers": pc.get("markers"),
            "duration_ms": context.get("duration_ms"),
        }
        return {
            "ok": True,
            "plan": completed_plan,
            "executed": True,
            "summary": summary,
            "markdown": architecture.get("markdown"),
            "gaps": gaps,
            "roadmap": arch_json.get("suggested_backlog"),
            "metrics": metrics,
        }
    return {
        "ok": True,
        "plan": completed_plan,
        "executed": True,
        "result": architecture,
        "project_context": context.get("project_context"),
        "pipeline": PROJECT_INTELLIGENCE_SEQUENCE,
    }
