from __future__ import annotations

import json
import time
from datetime import datetime
from pathlib import Path
from typing import Any

from fastapi import APIRouter, HTTPException, Security
from fastapi.security import HTTPAuthorizationCredentials
from pydantic import BaseModel, Field

from app.auth import bearerAuth, verify_admin_token
from app.project_intelligence.architecture import generate_architecture_from_context
from app.project_intelligence.context_builder import build_project_context
from app.project_intelligence.dispatcher import dispatch_capability, list_capabilities
from app.project_intelligence.planner import PROJECT_INTELLIGENCE_SEQUENCE, build_project_intelligence_plan


router = APIRouter(prefix="/project-intelligence", tags=["project_intelligence"])

AUDIT_LOG = Path("/opt/agente-divina/logs/admin_actions.log")


class ProjectScanRequest(BaseModel):
    path: str | None = None
    max_files: int = Field(default=5_000, ge=1, le=25_000)
    module: str | None = None


class CapabilityDispatchRequest(BaseModel):
    capability: str
    parameters: dict[str, Any] = Field(default_factory=dict)


class GoalRequest(BaseModel):
    goal: str
    path: str | None = None
    execute: bool = True
    compact: bool = True
    max_files: int = Field(default=5_000, ge=1, le=25_000)


def _require_admin(credentials: HTTPAuthorizationCredentials | None) -> None:
    verify_admin_token(credentials)


def _audit(action: str, detail: dict[str, Any]) -> None:
    event = {
        "timestamp": datetime.utcnow().isoformat(),
        "action": action,
        "detail": detail,
    }
    try:
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with AUDIT_LOG.open("a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")
    except Exception:
        pass


def _audit_payload(name: str, result: dict[str, Any], duration_ms: float) -> dict[str, Any]:
    payload = result.get("result", result)
    if not isinstance(payload, dict):
        payload = {}
    return {
        "capability": name,
        "duration_ms": duration_ms,
        "files_analyzed": payload.get("files_analyzed"),
        "modules_found": payload.get("modules_found") or len(payload.get("modules", []) or []),
        "errors": payload.get("errors", []),
        "warnings": payload.get("warnings", []),
    }


def _run(name: str, payload: dict[str, Any]) -> dict[str, Any]:
    started = time.perf_counter()
    result = dispatch_capability(name, payload)
    duration_ms = round((time.perf_counter() - started) * 1000, 2)
    _audit(f"project_intelligence.{name}", _audit_payload(name, result, duration_ms))
    if not result.get("ok") and result.get("error") == "capability_not_found":
        raise HTTPException(status_code=404, detail=result)
    return result


@router.get("/capabilities")
def project_intelligence_capabilities(
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    return {
        "ok": True,
        "domain": "project_intelligence",
        "capabilities": list_capabilities(),
    }


