from __future__ import annotations

import os
from typing import Any
from uuid import UUID

import psycopg2
import psycopg2.extras
from fastapi import APIRouter, HTTPException, Security
from fastapi.security import HTTPAuthorizationCredentials
from pydantic import BaseModel, Field

from app.auth import bearerAuth, verify_admin_token


router = APIRouter()


def _db_url() -> str:
    value = os.getenv("SUPABASE_DB_URL")
    if not value:
        raise HTTPException(status_code=500, detail="SUPABASE_DB_URL não configurado")
    return value


def _query(sql: str, params: tuple[Any, ...] = ()) -> list[dict[str, Any]]:
    try:
        with psycopg2.connect(_db_url()) as conn:
            with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
                cur.execute(sql, params)
                if cur.description:
                    return [dict(row) for row in cur.fetchall()]
                return []
    except Exception as exc:
        raise HTTPException(status_code=500, detail={"erro": "erro ao consultar banco", "detail": str(exc)}) from exc


def _execute_returning(sql: str, params: tuple[Any, ...] = ()) -> dict[str, Any] | None:
    rows = _query(sql, params)
    return rows[0] if rows else None


class SecurityUserCreateRequest(BaseModel):
    nome: str = Field(..., min_length=2)
    email: str
    tipo_usuario: str = "operador"
    departamento: str | None = None
    observacoes: str | None = None
    perfil_codigo: str | None = "consulta"
    empresa_id: int | None = None
    unidade_empresa_id: int | None = None
    acesso_todas_unidades: bool = False


class SecurityUserListRequest(BaseModel):
    ativo: bool | None = None
    search: str | None = None
    limit: int = Field(default=100, ge=1, le=500)


class SecurityGrantCompanyRequest(BaseModel):
    usuario_id: UUID
    empresa_id: int
    unidade_empresa_id: int | None = None
    perfil_codigo: str = "consulta"
    acesso_todas_unidades: bool = False
    observacoes: str | None = None


class SecurityAccessListRequest(BaseModel):
    usuario_id: UUID | None = None
    empresa_id: int | None = None
    ativo: bool | None = True
    limit: int = Field(default=200, ge=1, le=1000)


class SecurityExecuteRequest(BaseModel):
    operation: str = Field(
        ...,
        description=(
            "Operação de segurança do ERP. Valores: summary, list_users, create_user, "
            "grant_company, list_access, roles."
        ),
    )
    data: dict[str, Any] = Field(default_factory=dict, description="Dados da operação solicitada.")


@router.get(
    "/erp/security/summary",
    summary="Resumo de segurança do ERP",
    description="Retorna contadores de usuários, perfis, permissões e acessos multiempresa do ERP.",
)
def erp_security_summary(
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    rows = _query(
        """
        select
          (select count(*) from public.erp_usuarios) as usuarios,
          (select count(*) from public.erp_usuarios where ativo is true) as usuarios_ativos,
          (select count(*) from public.erp_perfis) as perfis,
          (select count(*) from public.erp_permissoes) as permissoes,
          (select count(*) from public.erp_perfil_permissao) as perfil_permissoes,
          (select count(*) from public.erp_usuario_empresa) as usuario_empresa_vinculos,
          (select count(*) from public.erp_auditoria) as auditorias,
          (select count(*) from public.empresas where coalesce(ativo,true) is true) as empresas_ativas,
          (select count(*) from public.unidades_empresa where coalesce(ativo,true) is true) as unidades_ativas
        """
    )
    return {"ok": True, "summary": rows[0] if rows else {}}


@router.post("/erp/security/users/list", summary="Listar usuários do ERP")
def erp_security_users_list(
    payload: SecurityUserListRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    clauses = []
    params: list[Any] = []
    if payload.ativo is not None:
        clauses.append("u.ativo = %s")
        params.append(payload.ativo)
    if payload.search:
        clauses.append("(u.nome ilike %s or u.email ilike %s)")
        term = f"%{payload.search}%"
        params.extend([term, term])
    where = " where " + " and ".join(clauses) if clauses else ""
    params.append(payload.limit)
    rows = _query(
        f"""
        select u.id, u.auth_user_id, u.nome, u.email, u.ativo, u.tipo_usuario,
               u.departamento, u.criado_em, u.atualizado_em,
               count(ue.id) as acessos_empresas
        from public.erp_usuarios u
        left join public.erp_usuario_empresa ue on ue.usuario_id = u.id and ue.ativo is true
        {where}
        group by u.id
        order by u.nome, u.email
        limit %s
        """,
        tuple(params),
    )
    return {"ok": True, "count": len(rows), "users": rows}


@router.post("/erp/security/users/create", summary="Criar usuário operacional do ERP")
def erp_security_users_create(
    payload: SecurityUserCreateRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    user = _execute_returning(
        """
        insert into public.erp_usuarios (nome, email, tipo_usuario, departamento, observacoes)
        values (%s, lower(%s), %s, %s, %s)
        on conflict (email) do update set
          nome = excluded.nome,
          tipo_usuario = excluded.tipo_usuario,
          departamento = excluded.departamento,
          observacoes = excluded.observacoes,
          ativo = true,
          atualizado_em = now()
        returning id, nome, email, ativo, tipo_usuario, departamento
        """,
        (payload.nome, str(payload.email), payload.tipo_usuario, payload.departamento, payload.observacoes),
    )
    grant = None
    if payload.empresa_id is not None and payload.perfil_codigo:
        grant = _grant_company_access(
            usuario_id=str(user["id"]),
            empresa_id=payload.empresa_id,
            unidade_empresa_id=payload.unidade_empresa_id,
            perfil_codigo=payload.perfil_codigo,
            acesso_todas_unidades=payload.acesso_todas_unidades,
            observacoes="Acesso criado junto com usuário.",
        )
    return {"ok": True, "user": user, "company_access": grant}


def _grant_company_access(
    usuario_id: str,
    empresa_id: int,
    unidade_empresa_id: int | None,
    perfil_codigo: str,
    acesso_todas_unidades: bool,
    observacoes: str | None,
) -> dict[str, Any]:
    if not acesso_todas_unidades and unidade_empresa_id is None:
        raise HTTPException(status_code=400, detail="Informe unidade_empresa_id ou marque acesso_todas_unidades=true")
    rows = _query("select id from public.erp_perfis where codigo=%s and ativo is true", (perfil_codigo,))
    if not rows:
        raise HTTPException(status_code=404, detail={"erro": "perfil não encontrado", "perfil_codigo": perfil_codigo})
    perfil_id = rows[0]["id"]
    row = _execute_returning(
        """
        insert into public.erp_usuario_empresa
          (usuario_id, empresa_id, unidade_empresa_id, perfil_id, acesso_todas_unidades, observacoes)
        values (%s, %s, %s, %s, %s, %s)
        on conflict (usuario_id, empresa_id, coalesce(unidade_empresa_id, 0), coalesce(perfil_id, '00000000-0000-0000-0000-000000000000'::uuid))
        do update set
          ativo = true,
          acesso_todas_unidades = excluded.acesso_todas_unidades,
          observacoes = excluded.observacoes,
          atualizado_em = now()
        returning id, usuario_id, empresa_id, unidade_empresa_id, perfil_id, ativo, acesso_todas_unidades
        """,
        (usuario_id, empresa_id, unidade_empresa_id, perfil_id, acesso_todas_unidades, observacoes),
    )
    return row or {}


@router.post("/erp/security/access/grant-company", summary="Conceder acesso multiempresa ao usuário")
def erp_security_grant_company(
    payload: SecurityGrantCompanyRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    row = _grant_company_access(
        usuario_id=str(payload.usuario_id),
        empresa_id=payload.empresa_id,
        unidade_empresa_id=payload.unidade_empresa_id,
        perfil_codigo=payload.perfil_codigo,
        acesso_todas_unidades=payload.acesso_todas_unidades,
        observacoes=payload.observacoes,
    )
    return {"ok": True, "access": row}


@router.post("/erp/security/access/list", summary="Listar acessos multiempresa dos usuários")
def erp_security_access_list(
    payload: SecurityAccessListRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    clauses = []
    params: list[Any] = []
    if payload.usuario_id is not None:
        clauses.append("usuario_id = %s")
        params.append(str(payload.usuario_id))
    if payload.empresa_id is not None:
        clauses.append("empresa_id = %s")
        params.append(payload.empresa_id)
    if payload.ativo is not None:
        clauses.append("ativo = %s")
        params.append(payload.ativo)
    where = " where " + " and ".join(clauses) if clauses else ""
    params.append(payload.limit)
    rows = _query(
        f"""
        select * from public.vw_erp_usuario_acessos
        {where}
        order by usuario_nome, empresa_nome, unidade_nome nulls first, perfil_nome nulls last
        limit %s
        """,
        tuple(params),
    )
    return {"ok": True, "count": len(rows), "accesses": rows}


@router.post(
    "/erp/security",
    summary="Executar operação de segurança do ERP",
    description=(
        "Endpoint único para administrar segurança do ERP. Operações: summary, list_users, "
        "create_user, grant_company, list_access e roles."
    ),
)
def erp_security_execute(
    payload: SecurityExecuteRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    operation = str(payload.operation or "").strip().lower()
    data = payload.data or {}

    if operation == "summary":
        return erp_security_summary(credentials)

    if operation == "list_users":
        return erp_security_users_list(SecurityUserListRequest(**data), credentials)

    if operation == "create_user":
        return erp_security_users_create(SecurityUserCreateRequest(**data), credentials)

    if operation == "grant_company":
        return erp_security_grant_company(SecurityGrantCompanyRequest(**data), credentials)

    if operation == "list_access":
        return erp_security_access_list(SecurityAccessListRequest(**data), credentials)

    if operation == "roles":
        return erp_security_roles(credentials)

    raise HTTPException(
        status_code=400,
        detail={
            "erro": "operação não suportada",
            "operation": operation,
            "allowed": ["summary", "list_users", "create_user", "grant_company", "list_access", "roles"],
        },
    )


@router.get("/erp/security/roles", summary="Listar perfis e permissões do ERP")
def erp_security_roles(
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    verify_admin_token(credentials)
    perfis = _query("select id, codigo, nome, descricao, ativo from public.erp_perfis order by nome")
    permissoes = _query("select codigo, modulo, acao, descricao, nivel_risco, altera_dados from public.erp_permissoes order by modulo, codigo")
    return {"ok": True, "perfis": perfis, "permissoes": permissoes}
