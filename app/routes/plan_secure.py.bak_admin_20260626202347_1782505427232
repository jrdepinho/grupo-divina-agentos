from __future__ import annotations

import json
import subprocess
from datetime import datetime
from pathlib import Path
from typing import Any, Literal

from fastapi import APIRouter, HTTPException, Security
from fastapi.security import HTTPAuthorizationCredentials
from pydantic import BaseModel, Field

from app.auth import bearerAuth, verify_admin_token


router = APIRouter()

AUDIT_LOG = Path("/opt/agente-divina/logs/admin_actions.log")
ALLOWED_SERVICES = (
    "agente-divina-api.service",
    "agente-divina-v2.service",
    "nginx.service",
)
ALLOWED_DEPLOY_ROOT = Path("/opt/agente-divina-v2")


class AdminPlanExecuteRequest(BaseModel):
    plan: Literal["diagnose", "validate_v2", "restart_v2"]
    include_logs: bool = True
    log_lines: int = Field(default=80, ge=1, le=300)


def _require_admin(credentials: HTTPAuthorizationCredentials | None) -> None:
    verify_admin_token(credentials)


def _audit(action: str, detail: dict[str, Any]) -> None:
    event = {
        "timestamp": datetime.utcnow().isoformat(),
        "action": action,
        "detail": detail,
    }
    try:
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with AUDIT_LOG.open("a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")
    except Exception:
        pass


def _run(tokens: list[str], cwd: str = "/tmp", timeout: int = 60) -> dict[str, Any]:
    proc = subprocess.run(
        tokens,
        shell=False,
        cwd=cwd,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    return {
        "ok": proc.returncode == 0,
        "cmd": " ".join(tokens),
        "cwd": cwd,
        "exit_code": proc.returncode,
        "stdout": proc.stdout[-20000:],
        "stderr": proc.stderr[-20000:],
    }


def _service_status(service: str) -> dict[str, Any]:
    return _run(["systemctl", "is-active", service], timeout=20)


def _service_logs(service: str, lines: int) -> dict[str, Any]:
    return _run(["journalctl", "-u", service, "-n", str(lines), "--no-pager"], timeout=60)


def _diagnose(include_logs: bool, log_lines: int) -> dict[str, Any]:
    services = {service: _service_status(service) for service in ALLOWED_SERVICES}
    nginx_test = _run(["nginx", "-t"], timeout=60)
    health_v2 = _run(["curl", "-sS", "http://127.0.0.1:8050/health"], timeout=30)
    health_v1 = _run(["curl", "-sS", "http://127.0.0.1:8000/health"], timeout=30)

    logs = {}
    if include_logs:
        logs = {
            "agente-divina-api.service": _service_logs("agente-divina-api.service", log_lines),
            "agente-divina-v2.service": _service_logs("agente-divina-v2.service", log_lines),
            "nginx.service": _service_logs("nginx.service", min(log_lines, 80)),
        }

    ok = all(item["ok"] and item["stdout"].strip() == "active" for item in services.values()) and nginx_test["ok"]
    return {
        "ok": ok,
        "plan": "diagnose",
        "services": services,
        "nginx_test": nginx_test,
        "health": {
            "v1_8000": health_v1,
            "v2_8050": health_v2,
        },
        "logs": logs,
    }


def _validate_v2() -> dict[str, Any]:
    compile_main = _run(["python3", "-m", "py_compile", "app/main.py"], cwd=str(ALLOWED_DEPLOY_ROOT), timeout=120)
    compile_admin = _run(["python3", "-m", "py_compile", "app/routes/admin_secure.py"], cwd=str(ALLOWED_DEPLOY_ROOT), timeout=120)
    compile_deploy = _run(["python3", "-m", "py_compile", "app/routes/deploy_secure.py"], cwd=str(ALLOWED_DEPLOY_ROOT), timeout=120)
    compile_plan = _run(["python3", "-m", "py_compile", "app/routes/plan_secure.py"], cwd=str(ALLOWED_DEPLOY_ROOT), timeout=120)
    openapi_check = _run(["curl", "-sS", "http://127.0.0.1:8050/openapi-gpt.json"], timeout=60)
    results = {
        "compile_main": compile_main,
        "compile_admin": compile_admin,
        "compile_deploy": compile_deploy,
        "compile_plan": compile_plan,
        "openapi_check": openapi_check,
    }
    return {"ok": all(item["ok"] for item in results.values()), "plan": "validate_v2", "results": results}


def _restart_v2(include_logs: bool, log_lines: int) -> dict[str, Any]:
    restart = _run(["systemctl", "restart", "agente-divina-v2.service"], timeout=120)
    status = _service_status("agente-divina-v2.service")
    health = _run(["curl", "-sS", "http://127.0.0.1:8050/health"], timeout=30)
    logs = _service_logs("agente-divina-v2.service", log_lines) if include_logs else None
    return {
        "ok": status["ok"] and status["stdout"].strip() == "active" and health["ok"],
        "plan": "restart_v2",
        "restart": restart,
        "status": status,
        "health": health,
        "logs": logs,
    }


@router.post("/admin/plan/execute")
def admin_plan_execute(
    payload: AdminPlanExecuteRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)

    if payload.plan == "diagnose":
        result = _diagnose(payload.include_logs, payload.log_lines)
    elif payload.plan == "validate_v2":
        result = _validate_v2()
    elif payload.plan == "restart_v2":
        result = _restart_v2(payload.include_logs, payload.log_lines)
    else:
        raise HTTPException(status_code=400, detail="plano não suportado")

    _audit("plan.execute", {"plan": payload.plan, "ok": result.get("ok")})
    return result
