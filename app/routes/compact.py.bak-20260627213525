from __future__ import annotations

import os
import subprocess
from typing import Any

import psycopg2
import psycopg2.extras
import requests
from fastapi import APIRouter, HTTPException, Security
from fastapi.security import HTTPAuthorizationCredentials
from pydantic import BaseModel, Field

from app.auth import bearerAuth, verify_admin_token


router = APIRouter()


class CompactOperationRequest(BaseModel):
    operation: str = Field(..., description="Nome da operação a executar dentro do domínio.")
    data: dict[str, Any] = Field(default_factory=dict, description="Parâmetros da operação.")


def _auth_header(credentials: HTTPAuthorizationCredentials | None) -> dict[str, str]:
    verify_admin_token(credentials)
    token = credentials.credentials if credentials else ""
    return {"Authorization": f"Bearer {token}"}


def _local(method: str, path: str, credentials: HTTPAuthorizationCredentials | None, data: dict[str, Any] | None = None, timeout: int = 180) -> dict[str, Any]:
    port = os.getenv("LOCAL_API_PORT", "8000")
    url = f"http://127.0.0.1:{port}{path}"
    headers = _auth_header(credentials)
    try:
        resp = requests.request(method.upper(), url, headers=headers, json=data if data is not None else None, timeout=timeout)
    except Exception as exc:
        raise HTTPException(status_code=502, detail={"erro": "falha em chamada local", "path": path, "detail": str(exc)}) from exc
    try:
        parsed = resp.json()
    except Exception:
        parsed = resp.text
    if resp.status_code >= 400:
        raise HTTPException(status_code=resp.status_code, detail=parsed)
    return parsed


def _db_url() -> str:
    value = os.getenv("SUPABASE_DB_URL")
    if not value:
        raise HTTPException(status_code=500, detail="SUPABASE_DB_URL não configurado")
    return value


def _select(sql: str, params: tuple[Any, ...] = (), limit: int = 500) -> list[dict[str, Any]]:
    if not sql.strip().lower().startswith("select"):
        raise HTTPException(status_code=400, detail="Apenas SELECT permitido nesta operação compacta")
    with psycopg2.connect(_db_url()) as conn:
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute(sql, params)
            rows = cur.fetchall()
            return [dict(row) for row in rows[:limit]]


def _execute(sql: str, params: tuple[Any, ...] = ()) -> list[dict[str, Any]]:
    with psycopg2.connect(_db_url()) as conn:
        with conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute(sql, params)
            if cur.description:
                return [dict(row) for row in cur.fetchall()]
            return []


def _supabase_auth_config() -> tuple[str, str]:
    url = os.getenv("SUPABASE_URL")
    key = os.getenv("SUPABASE_SERVICE_ROLE_KEY")
    if not url or not key:
        raise HTTPException(status_code=500, detail="SUPABASE_URL ou SUPABASE_SERVICE_ROLE_KEY não configurados")
    return url.rstrip("/"), key


def _supabase_auth_request(path: str, payload: dict[str, Any], timeout: int = 120) -> dict[str, Any]:
    return _supabase_auth_any("POST", path, payload, timeout)


def _supabase_auth_any(method: str, path: str, payload: dict[str, Any] | None = None, timeout: int = 120) -> dict[str, Any]:
    url, key = _supabase_auth_config()
    try:
        resp = requests.request(
            method.upper(),
            f"{url}/auth/v1{path}",
            headers={
                "apikey": key,
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
            },
            json=payload if payload is not None else None,
            timeout=timeout,
        )
    except Exception as exc:
        raise HTTPException(status_code=502, detail={"erro": "falha ao chamar Supabase Auth", "detail": str(exc)}) from exc
    try:
        parsed = resp.json()
    except Exception:
        parsed = resp.text
    if resp.status_code >= 400:
        raise HTTPException(status_code=resp.status_code, detail={"erro": "Supabase Auth retornou erro", "status": resp.status_code, "response": parsed})
    return {"ok": True, "status": resp.status_code, "response": parsed}


@router.post(
    "/admin",
    summary="Executar operação administrativa compacta",
    description=(
        "Endpoint compacto para o GPT executar operações administrativas. "
        "Operações: plan_execute, catalog, diagnose, validate_v2, nightly_health, "
        "config_summary, capabilities, service_status, service_logs, service_restart, "
        "nginx_test, nginx_reload."
    ),
)
def compact_admin(
    payload: CompactOperationRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    operation = str(payload.operation or "").strip().lower()
    data = payload.data or {}
    _auth_header(credentials)

    if operation in {"catalog", "diagnose", "validate_v2", "restart_v2", "backup_v2", "deploy_v2", "rollback_v2", "nightly_health"}:
        body = {"plan": operation, **data}
        return _local("POST", "/admin/plan/execute", credentials, body)

    if operation == "plan_execute":
        return _local("POST", "/admin/plan/execute", credentials, data)
    if operation == "config_summary":
        return _local("GET", "/admin/config/summary", credentials)
    if operation == "capabilities":
        return _local("GET", "/admin/capabilities", credentials)
    if operation == "service_status":
        return _local("POST", "/admin/service/status", credentials, data)
    if operation == "service_logs":
        return _local("POST", "/admin/service/logs", credentials, data)
    if operation == "service_restart":
        return _local("POST", "/admin/service/restart", credentials, data)
    if operation == "nginx_test":
        return _local("POST", "/admin/nginx/test", credentials, {})
    if operation == "nginx_reload":
        return _local("POST", "/admin/nginx/reload", credentials, {})

    raise HTTPException(status_code=400, detail={"erro": "operação administrativa não suportada", "operation": operation})


@router.post(
    "/erp",
    summary="Executar operação compacta do ERP",
    description=(
        "Endpoint compacto para operações do ERP. Operações: sync_metadata, "
        "modules_summary, tables_by_module, table_columns, select."
    ),
)
def compact_erp(
    payload: CompactOperationRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    operation = str(payload.operation or "").strip().lower()
    data = payload.data or {}
    _auth_header(credentials)

    if operation == "sync_metadata":
        return _local("POST", "/erp/sync-metadata", credentials, data)
    if operation == "modules_summary":
        rows = _select("select module_name, count(*) as tables_count from public.erp_metadata_tables group by module_name order by tables_count desc")
        return {"ok": True, "modules": rows}
    if operation == "tables_by_module":
        module = data.get("module_name")
        if module:
            rows = _select("select schema_name, table_name, business_name, description, criticality, source_type from public.erp_metadata_tables where module_name=%s order by table_name", (module,))
        else:
            rows = _select("select schema_name, table_name, module_name, business_name, description, criticality, source_type from public.erp_metadata_tables order by module_name, table_name")
        return {"ok": True, "count": len(rows), "tables": rows}
    if operation == "table_columns":
        table = data.get("table_name")
        schema = data.get("schema_name", "public")
        if not table:
            raise HTTPException(status_code=400, detail="table_name obrigatório")
        rows = _select("select column_name, data_type, business_name, description, is_required, is_primary_key, is_foreign_key from public.erp_metadata_columns where schema_name=%s and table_name=%s order by column_name", (schema, table))
        return {"ok": True, "table_name": table, "count": len(rows), "columns": rows}
    if operation == "select":
        sql = str(data.get("sql") or "")
        limit = int(data.get("limit") or 500)
        return {"ok": True, "rows": _select(sql, limit=max(1, min(limit, 500)))}

    raise HTTPException(status_code=400, detail={"erro": "operação ERP não suportada", "operation": operation})


@router.post(
    "/fiscal",
    summary="Executar operação fiscal compacta",
    description="Endpoint compacto para Fiscal/XML/SEFAZ. Operações: nsu, processar_xml, sefaz_hogar, sefaz_ttf, auditoria_dashboard, auditoria_importacao.",
)
def compact_fiscal(
    payload: CompactOperationRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    operation = str(payload.operation or "").strip().lower()
    data = payload.data or {}
    _auth_header(credentials)

    if operation == "nsu":
        return _local("GET", "/nsu", credentials)
    if operation == "processar_xml":
        return _local("POST", "/processar-xml", credentials, {})
    if operation == "sefaz_hogar":
        return _local("POST", "/sefaz/hogar", credentials, {})
    if operation == "sefaz_ttf":
        return _local("POST", "/sefaz/ttf", credentials, {})
    if operation == "auditoria_dashboard":
        return _local("GET", "/auditoria_dashboard", credentials)
    if operation == "auditoria_importacao":
        chave = data.get("chave_nfe")
        if not chave:
            raise HTTPException(status_code=400, detail="chave_nfe obrigatória")
        return _local("GET", f"/auditoria_importacao/{chave}", credentials)

    raise HTTPException(status_code=400, detail={"erro": "operação fiscal não suportada", "operation": operation})


@router.post(
    "/supabase",
    summary="Executar operação compacta do Supabase",
    description="Endpoint compacto para Supabase. Operações: admin_sql, select, metadata_counts.",
)
def compact_supabase(
    payload: CompactOperationRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    operation = str(payload.operation or "").strip().lower()
    data = payload.data or {}
    _auth_header(credentials)

    if operation == "admin_sql":
        return _local("POST", "/supabase/admin/sql", credentials, data, timeout=240)
    if operation == "select":
        sql = str(data.get("sql") or "")
        limit = int(data.get("limit") or 500)
        return {"ok": True, "rows": _select(sql, limit=max(1, min(limit, 500)))}
    if operation == "metadata_counts":
        rows = _select(
            """
            select
              (select count(*) from public.erp_metadata_tables) as metadata_tables,
              (select count(*) from public.erp_metadata_columns) as metadata_columns,
              (select count(*) from public.erp_relationships) as relationships,
              (select count(*) from public.erp_usuarios) as usuarios,
              (select count(*) from public.erp_perfis) as perfis,
              (select count(*) from public.erp_permissoes) as permissoes
            """
        )
        return {"ok": True, "counts": rows[0] if rows else {}}

    if operation == "invite_user":
        email = str(data.get("email") or "").strip().lower()
        redirect_to = str(data.get("redirect_to") or "").strip() or None
        if not email:
            raise HTTPException(status_code=400, detail="email obrigatório")

        payload = {"email": email}
        if redirect_to:
            payload["redirect_to"] = redirect_to

        invite = _supabase_auth_request("/invite", payload)
        response = invite.get("response") if isinstance(invite, dict) else {}
        auth_user_id = None
        if isinstance(response, dict):
            auth_user_id = response.get("id") or response.get("user", {}).get("id")

        updated = []
        if auth_user_id:
            updated = _execute(
                """
                update public.erp_usuarios
                set auth_user_id = %s,
                    atualizado_em = now()
                where lower(email) = lower(%s)
                returning id, nome, email, auth_user_id, ativo
                """,
                (auth_user_id, email),
            )
            _execute(
                """
                insert into public.erp_auditoria (modulo, acao, entidade, entidade_id, valores_novos, origem)
                values ('Segurança', 'invite_user', 'erp_usuarios', %s, %s::jsonb, 'agente_divina')
                """,
                (str(updated[0]["id"]) if updated else email, __import__("json").dumps({"email": email, "auth_user_id": auth_user_id})),
            )

        return {
            "ok": True,
            "operation": "invite_user",
            "email": email,
            "auth_user_id": auth_user_id,
            "erp_user_updated": bool(updated),
            "erp_user": updated[0] if updated else None,
            "supabase": invite,
        }


    if operation == "set_user_password":
        email = str(data.get("email") or "").strip().lower()
        password = str(data.get("password") or "")
        confirm = bool(data.get("confirm"))

        if not email:
            raise HTTPException(status_code=400, detail="email obrigatório")
        if len(password) < 8:
            raise HTTPException(status_code=400, detail="senha deve ter pelo menos 8 caracteres")
        if not confirm:
            raise HTTPException(status_code=400, detail="confirmação explícita obrigatória")

        users = _select(
            "select id, nome, email, auth_user_id from public.erp_usuarios where lower(email)=lower(%s) limit 1",
            (email,),
        )
        if not users or not users[0].get("auth_user_id"):
            raise HTTPException(status_code=404, detail="usuário ERP não encontrado ou sem auth_user_id")

        auth_user_id = str(users[0]["auth_user_id"])

        result = _supabase_auth_any(
            "PUT",
            f"/admin/users/{auth_user_id}",
            {"password": password, "email_confirm": True},
        )

        _execute(
            """
            insert into public.erp_auditoria (modulo, acao, entidade, entidade_id, valores_novos, origem)
            values ('Segurança', 'set_user_password', 'auth.users', %s, %s::jsonb, 'agente_divina')
            """,
            (auth_user_id, __import__("json").dumps({"email": email, "auth_user_id": auth_user_id, "senha_alterada": True})),
        )

        return {
            "ok": True,
            "operation": "set_user_password",
            "email": email,
            "auth_user_id": auth_user_id,
            "message": "Senha atualizada com sucesso no Supabase Auth.",
            "supabase_status": result.get("status"),
        }

    if operation == "list_auth_users":
        page = int(data.get("page") or 1)
        per_page = int(data.get("per_page") or data.get("limit") or 50)
        per_page = max(1, min(per_page, 100))
        return _supabase_auth_any("GET", f"/admin/users?page={page}&per_page={per_page}", None)

    if operation == "get_auth_user_by_email":
        email = str(data.get("email") or "").strip().lower()
        if not email:
            raise HTTPException(status_code=400, detail="email obrigatório")

        result = _supabase_auth_any("GET", "/admin/users?page=1&per_page=1000", None)
        response = result.get("response") if isinstance(result, dict) else {}
        users = response.get("users", []) if isinstance(response, dict) else []
        matches = [u for u in users if str(u.get("email") or "").lower() == email]

        erp_users = _select(
            "select id, nome, email, auth_user_id, ativo from public.erp_usuarios where lower(email)=lower(%s) limit 5",
            (email,),
        )

        return {
            "ok": True,
            "email": email,
            "found": bool(matches),
            "auth_user": matches[0] if matches else None,
            "erp_user": erp_users[0] if erp_users else None,
            "erp_user_found": bool(erp_users),
        }

    if operation == "auth_user_status":
        email = str(data.get("email") or "").strip().lower()
        if not email:
            raise HTTPException(status_code=400, detail="email obrigatório")

        result = _supabase_auth_any("GET", "/admin/users?page=1&per_page=1000", None)
        response = result.get("response") if isinstance(result, dict) else {}
        users = response.get("users", []) if isinstance(response, dict) else []
        user = next((u for u in users if str(u.get("email") or "").lower() == email), None)

        erp_users = _select(
            "select id, nome, email, auth_user_id, ativo from public.erp_usuarios where lower(email)=lower(%s) limit 5",
            (email,),
        )
        erp_user = erp_users[0] if erp_users else None

        return {
            "ok": True,
            "email": email,
            "auth_exists": bool(user),
            "auth_user_id": user.get("id") if user else None,
            "email_confirmed": bool(user.get("email_confirmed_at")) if user else False,
            "last_sign_in_at": user.get("last_sign_in_at") if user else None,
            "created_at": user.get("created_at") if user else None,
            "erp_exists": bool(erp_user),
            "erp_user": erp_user,
            "auth_user": user,
        }

    if operation == "auth_admin":
        method = str(data.get("method") or "GET").upper()
        path = str(data.get("path") or "").strip()
        body = data.get("body") or None

        allowed_methods = {"GET", "POST", "PATCH", "PUT"}
        if method not in allowed_methods:
            raise HTTPException(status_code=400, detail="método não permitido")
        if not path.startswith("/admin/"):
            raise HTTPException(status_code=400, detail="path deve começar com /admin/")

        return _supabase_auth_any(method, path, body)


    raise HTTPException(status_code=400, detail={"erro": "operação Supabase não suportada", "operation": operation})
