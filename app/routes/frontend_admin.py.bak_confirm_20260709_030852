from __future__ import annotations

import os
import subprocess
from pathlib import Path
from typing import Any

from fastapi import APIRouter, Header, HTTPException
from pydantic import BaseModel, Field

router = APIRouter(prefix="/frontend", tags=["Frontend Admin"])

ADMIN_TOKEN = os.getenv("AGENTE_ADMIN_TOKEN", "")
ROOT = Path("/opt/grupo-divina-dashboard").resolve()
AUDIT_LOG = Path("/opt/agente-divina/logs/admin_actions.log")


class FrontendRequest(BaseModel):
    operation: str = Field(..., description="status, list, read, write, shell, git, npm")
    data: dict[str, Any] = Field(default_factory=dict)


def _check(auth: str | None):
    if not ADMIN_TOKEN:
        raise HTTPException(status_code=500, detail="AGENTE_ADMIN_TOKEN não configurado")
    if not auth or auth != f"Bearer {ADMIN_TOKEN}":
        raise HTTPException(status_code=401, detail="Unauthorized ADMIN ACCESS")


def _safe_path(rel: str) -> Path:
    p = (ROOT / rel.lstrip("/")).resolve()
    if not str(p).startswith(str(ROOT)):
        raise HTTPException(status_code=400, detail="path fora do diretório permitido")
    return p


def _run(cmd: list[str], timeout: int = 120) -> dict[str, Any]:
    proc = subprocess.run(
        cmd,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    return {
        "cmd": cmd,
        "returncode": proc.returncode,
        "stdout": proc.stdout[-12000:],
        "stderr": proc.stderr[-12000:],
    }


def _audit(operation: str, data: dict[str, Any], result: dict[str, Any] | None = None):
    AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
    masked = dict(data or {})
    for k in list(masked):
        if "password" in k.lower() or "token" in k.lower() or "key" in k.lower():
            masked[k] = "***"
    AUDIT_LOG.open("a").write(f"frontend_admin operation={operation} data={masked} result_code={result.get('returncode') if result else None}\n")


@router.post("", operation_id="frontend_admin_v1")
def frontend_admin(req: FrontendRequest, authorization: str | None = Header(default=None)):
    _check(authorization)

    op = req.operation
    data = req.data or {}

    if op == "status":
        return {
            "ok": True,
            "root": str(ROOT),
            "exists": ROOT.exists(),
            "package_json": (ROOT / "package.json").exists(),
        }

    if op == "list":
        rel = data.get("path", ".")
        max_depth = int(data.get("max_depth", 3))
        base = _safe_path(rel)
        items = []
        for p in base.rglob("*"):
            depth = len(p.relative_to(base).parts)
            if depth <= max_depth:
                items.append({
                    "path": str(p.relative_to(ROOT)),
                    "type": "dir" if p.is_dir() else "file",
                })
        return {"ok": True, "items": items[:1000]}

    if op == "read":
        p = _safe_path(str(data.get("path", "")))
        if not p.is_file():
            raise HTTPException(status_code=404, detail="arquivo não encontrado")
        return {"ok": True, "path": str(p.relative_to(ROOT)), "content": p.read_text()}

    if op == "write":
        p = _safe_path(str(data.get("path", "")))
        content = str(data.get("content", ""))
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content)
        _audit(op, {"path": str(p.relative_to(ROOT))})
        return {"ok": True, "path": str(p.relative_to(ROOT)), "bytes": len(content.encode())}

    if op == "shell":
        cmd = data.get("cmd")
        confirm = bool(data.get("confirm"))
        if not confirm:
            raise HTTPException(status_code=400, detail="confirm=true obrigatório")
        if not isinstance(cmd, list) or not cmd:
            raise HTTPException(status_code=400, detail="cmd deve ser lista")
        allowed = {"ls", "cat", "find", "grep", "npm", "git", "node"}
        if cmd[0] not in allowed:
            raise HTTPException(status_code=400, detail=f"comando não permitido: {cmd[0]}")
        result = _run([str(x) for x in cmd], int(data.get("timeout", 120)))
        _audit(op, {"cmd": cmd}, result)
        return {"ok": result["returncode"] == 0, **result}

    if op == "git":
        action = str(data.get("action", "status"))
        allowed_actions = {
            "status": ["git", "status"],
            "log": ["git", "log", "--oneline", "-10"],
            "pull": ["git", "pull", "--ff-only"],
            "add_all": ["git", "add", "."],
            "push": ["git", "push"],
        }

        if action == "commit":
            msg = str(data.get("message") or "ERP update")
            result = _run(["git", "commit", "-m", msg], 120)
        elif action in allowed_actions:
            result = _run(allowed_actions[action], 120)
        else:
            raise HTTPException(status_code=400, detail="ação git não permitida")

        _audit(op, {"action": action}, result)
        return {"ok": result["returncode"] == 0, **result}

    if op == "npm":
        action = str(data.get("action", "build"))
        if action == "build":
            cmd = ["npm", "run", "build"]
        elif action == "install":
            cmd = ["npm", "install"]
        elif action == "lint":
            cmd = ["npm", "run", "lint"]
        else:
            raise HTTPException(status_code=400, detail="ação npm não permitida")

        result = _run(cmd, int(data.get("timeout", 300)))
        _audit(op, {"action": action}, result)
        return {"ok": result["returncode"] == 0, **result}

    raise HTTPException(status_code=400, detail="operação não suportada")
