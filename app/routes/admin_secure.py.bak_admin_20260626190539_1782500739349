from __future__ import annotations

import json
import shlex
import shutil
import subprocess
import time
from datetime import datetime
from pathlib import Path
from typing import Any

from fastapi import APIRouter, HTTPException, Security
from fastapi.security import HTTPAuthorizationCredentials
from pydantic import BaseModel, Field

from app.auth import bearerAuth, verify_admin_token


router = APIRouter()

AUDIT_LOG = Path("/opt/agente-divina/logs/admin_actions.log")
ALLOWED_FILE_ROOTS = (
    Path("/opt/agente-divina-v2"),
    Path("/opt/agente-divina/app"),
)
ALLOWED_EXEC_CWDS = ALLOWED_FILE_ROOTS
ALLOWED_SERVICES = (
    "agente-divina-api.service",
    "agente-divina-v2.service",
    "nginx.service",
)
ALLOWED_SERVICE = ALLOWED_SERVICES[0]

BLOCKED_COMMAND_FRAGMENTS = (
    "rm",
    "shutdown",
    "reboot",
    "mkfs",
    "dd",
    "chmod 777",
    "chown -r",
    ":(){ :|:& };:",
)
BLOCKED_SHELL_TOKENS = (";", "&&", "||", "|", "`", "$(", ">", "<")


class AdminFileReadRequest(BaseModel):
    path: str


class AdminFileWriteRequest(BaseModel):
    path: str
    content: str = ""


class AdminFilePatchRequest(BaseModel):
    path: str | None = None
    file: str | None = None
    search: str
    replace: str
    compile_python: bool = False


class AdminFileListRequest(BaseModel):
    path: str = "/opt/agente-divina-v2"
    pattern: str = "*"
    max_items: int = 300


class AdminExecRequest(BaseModel):
    cmd: str
    cwd: str = "/opt/agente-divina-v2"
    timeout: int = 120


class AdminServiceRequest(BaseModel):
    service: str = ALLOWED_SERVICE


class AdminServiceLogsRequest(BaseModel):
    service: str = ALLOWED_SERVICE
    lines: int = 200


class AdminDeployValidateRequest(BaseModel):
    cwd: str = "/opt/agente-divina-v2"
    commands: list[str] = Field(default_factory=lambda: ["python3 -m py_compile app/main.py"])


def _require_admin(credentials: HTTPAuthorizationCredentials | None) -> None:
    verify_admin_token(credentials)


def _is_relative_to(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def _resolve_path(raw_path: str) -> Path:
    if not raw_path or not str(raw_path).strip():
        raise HTTPException(status_code=400, detail="path obrigatório")
    return Path(str(raw_path)).expanduser().resolve()


def _validate_path(raw_path: str, roots: tuple[Path, ...] = ALLOWED_FILE_ROOTS) -> Path:
    path = _resolve_path(raw_path)
    resolved_roots = tuple(root.resolve() for root in roots)
    if not any(_is_relative_to(path, root) for root in resolved_roots):
        raise HTTPException(
            status_code=403,
            detail={
                "erro": "path fora dos diretórios permitidos",
                "path": str(path),
                "allowed_roots": [str(root) for root in resolved_roots],
            },
        )
    return path


def _validate_service(service: str) -> str:
    service = str(service).strip()
    if service != ALLOWED_SERVICE:
        raise HTTPException(
            status_code=403,
            detail={"erro": "serviço não permitido", "allowed": [ALLOWED_SERVICE]},
        )
    return service


def _audit(action: str, detail: dict[str, Any]) -> None:
    event = {
        "timestamp": datetime.utcnow().isoformat(),
        "action": action,
        "detail": detail,
    }
    try:
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with AUDIT_LOG.open("a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")
    except Exception:
        pass


def _backup_path(path: Path) -> Path:
    timestamp = datetime.utcnow().strftime("%Y%m%d%H%M%S")
    return path.with_name(f"{path.name}.bak_admin_{timestamp}_{int(time.time() * 1000)}")


def _create_backup(path: Path) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    backup = _backup_path(path)
    if path.exists():
        shutil.copy2(path, backup)
    else:
        backup.write_text("", encoding="utf-8")
    return backup


def _contains_blocked_fragment(cmd: str) -> str | None:
    lower = cmd.lower()
    for fragment in BLOCKED_COMMAND_FRAGMENTS:
        if fragment in lower:
            return fragment
    for token in BLOCKED_SHELL_TOKENS:
        if token in cmd:
            return token
    return None


def _validate_cwd(raw_cwd: str) -> Path:
    cwd = _validate_path(raw_cwd, ALLOWED_EXEC_CWDS)
    if not cwd.exists() or not cwd.is_dir():
        raise HTTPException(status_code=400, detail={"erro": "cwd não encontrado", "cwd": str(cwd)})
    return cwd


def _validate_absolute_args(tokens: list[str]) -> None:
    for token in tokens:
        if token.startswith("/") and not token.startswith("//"):
            _validate_path(token)


def _validate_py_compile(tokens: list[str], cwd: Path) -> None:
    if tokens[:3] != ["python3", "-m", "py_compile"] or len(tokens) < 4:
        raise HTTPException(status_code=403, detail="Comando python permitido apenas para py_compile")

    for token in tokens[3:]:
        if token.startswith("-"):
            continue
        path = Path(token)
        candidate = path if path.is_absolute() else cwd / path
        _validate_path(str(candidate))


def _validate_curl(tokens: list[str]) -> None:
    forbidden = {"-o", "--output", "-O", "-T", "--upload-file", "--data-binary"}
    if any(token in forbidden for token in tokens):
        raise HTTPException(status_code=403, detail="curl permitido apenas para consulta local sem upload/output")

    urls = [token for token in tokens[1:] if token.startswith("http://") or token.startswith("https://")]
    if not urls or not all(url.startswith("http://127.0.0.1") for url in urls):
        raise HTTPException(status_code=403, detail="curl permitido apenas para http://127.0.0.1")


def _validate_exec_command(cmd: str, cwd: Path) -> list[str]:
    cmd = str(cmd).strip()
    if not cmd:
        raise HTTPException(status_code=400, detail="cmd vazio")

    blocked = _contains_blocked_fragment(cmd)
    if blocked:
        raise HTTPException(status_code=403, detail=f"Comando bloqueado: {blocked}")

    try:
        tokens = shlex.split(cmd)
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=f"Comando inválido: {exc}") from exc

    if not tokens:
        raise HTTPException(status_code=400, detail="cmd vazio")

    command = tokens[0]

    if command == "pwd":
        if len(tokens) != 1:
            raise HTTPException(status_code=403, detail="pwd não aceita argumentos neste endpoint")
        return tokens

    if command in {"ls", "cat", "grep"}:
        _validate_absolute_args(tokens[1:])
        return tokens

    if command == "sed":
        if "-i" in tokens or any(token.startswith("-i") for token in tokens):
            raise HTTPException(status_code=403, detail="sed -i não permitido")
        _validate_absolute_args(tokens[1:])
        return tokens

    if command == "python3":
        _validate_py_compile(tokens, cwd)
        return tokens

    if command == "systemctl":
        if len(tokens) < 3 or tokens[1] != "status":
            raise HTTPException(status_code=403, detail="systemctl permitido apenas com status")
        _validate_service(tokens[2])
        return tokens

    if command == "journalctl":
        return tokens

    if command == "curl":
        _validate_curl(tokens)
        return tokens

    raise HTTPException(
        status_code=403,
        detail={
            "erro": "comando fora da whitelist",
            "allowed": [
                "pwd",
                "ls",
                "cat",
                "grep",
                "sed",
                "python3 -m py_compile",
                "systemctl status",
                "journalctl",
                "curl http://127.0.0.1",
            ],
        },
    )


def _run_checked_command(tokens: list[str], cwd: Path, timeout: int) -> dict[str, Any]:
    proc = subprocess.run(
        tokens,
        shell=False,
        cwd=str(cwd),
        capture_output=True,
        text=True,
        timeout=max(1, min(int(timeout), 300)),
    )
    return {
        "ok": proc.returncode == 0,
        "cmd": " ".join(shlex.quote(token) for token in tokens),
        "cwd": str(cwd),
        "exit_code": proc.returncode,
        "stdout": proc.stdout[-20000:],
        "stderr": proc.stderr[-20000:],
    }


@router.post("/admin/file/read")
def admin_file_read(
    payload: AdminFileReadRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    path = _validate_path(payload.path)
    if not path.exists() or not path.is_file():
        raise HTTPException(status_code=404, detail={"erro": "arquivo não encontrado", "path": str(path)})

    _audit("file.read", {"path": str(path)})
    return {
        "ok": True,
        "path": str(path),
        "content": path.read_text(encoding="utf-8", errors="replace"),
    }


@router.post("/admin/file/write")
def admin_file_write(
    payload: AdminFileWriteRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    path = _validate_path(payload.path)
    backup = _create_backup(path)
    content = str(payload.content)
    path.write_text(content, encoding="utf-8")

    _audit("file.write", {"path": str(path), "backup": str(backup), "bytes": len(content.encode("utf-8"))})
    return {
        "ok": True,
        "path": str(path),
        "backup": str(backup),
        "bytes": len(content.encode("utf-8")),
    }


@router.post("/admin/file/patch")
def admin_file_patch(
    payload: AdminFilePatchRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    target = payload.path or payload.file
    if not target:
        raise HTTPException(status_code=400, detail="path obrigatório")

    path = _validate_path(target)
    if not path.exists() or not path.is_file():
        raise HTTPException(status_code=404, detail={"erro": "arquivo não encontrado", "path": str(path)})

    text = path.read_text(encoding="utf-8", errors="replace")
    occurrences = text.count(str(payload.search))
    if occurrences == 0:
        raise HTTPException(status_code=400, detail={"erro": "trecho search não encontrado", "path": str(path)})

    backup = _create_backup(path)
    path.write_text(text.replace(str(payload.search), str(payload.replace), 1), encoding="utf-8")

    compile_result = None
    if payload.compile_python and path.suffix == ".py":
        compile_result = _run_checked_command(
            ["python3", "-m", "py_compile", str(path)],
            path.parent,
            60,
        )
        if not compile_result["ok"]:
            shutil.copy2(backup, path)
            _audit("file.patch.rollback", {"path": str(path), "backup": str(backup)})
            return {
                "ok": False,
                "erro": "compilação falhou; arquivo restaurado do backup",
                "path": str(path),
                "backup": str(backup),
                "compile": compile_result,
            }

    _audit("file.patch", {"path": str(path), "backup": str(backup), "replaced": 1})
    return {
        "ok": True,
        "path": str(path),
        "backup": str(backup),
        "occurrences_before": occurrences,
        "replaced": 1,
        "compile": compile_result,
    }


@router.post("/admin/file/list")
def admin_file_list(
    payload: AdminFileListRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    base = _validate_path(payload.path)
    if not base.exists() or not base.is_dir():
        raise HTTPException(status_code=404, detail={"erro": "diretório não encontrado", "path": str(base)})

    pattern = str(payload.pattern or "*")
    max_items = max(1, min(int(payload.max_items or 300), 1000))
    items = []
    for item in base.rglob(pattern):
        if len(items) >= max_items:
            break
        items.append(
            {
                "path": str(item),
                "type": "dir" if item.is_dir() else "file",
                "size": item.stat().st_size if item.is_file() else None,
            }
        )

    _audit("file.list", {"path": str(base), "pattern": pattern, "count": len(items)})
    return {"ok": True, "base": str(base), "pattern": pattern, "count": len(items), "items": items}


@router.post("/admin/exec")
def admin_exec(
    payload: AdminExecRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    blocked = _contains_blocked_fragment(payload.cmd)
    if blocked:
        _audit("exec.blocked", {"cmd": str(payload.cmd), "reason": blocked})
        raise HTTPException(status_code=403, detail=f"Comando bloqueado: {blocked}")

    cwd = _validate_cwd(payload.cwd)
    tokens = _validate_exec_command(payload.cmd, cwd)
    result = _run_checked_command(tokens, cwd, payload.timeout)
    _audit("exec", {"cmd": result["cmd"], "cwd": str(cwd), "ok": result["ok"], "exit_code": result["exit_code"]})
    return result


@router.post("/admin/service/status")
def admin_service_status(
    payload: AdminServiceRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    service = _validate_service(payload.service)
    result = _run_checked_command(["systemctl", "status", service, "--no-pager"], Path("/tmp"), 30)
    _audit("service.status", {"service": service, "ok": result["ok"]})
    return result


@router.post("/admin/service/restart")
def admin_service_restart(
    payload: AdminServiceRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    service = _validate_service(payload.service)
    restart = subprocess.run(
        ["systemctl", "restart", service],
        shell=False,
        capture_output=True,
        text=True,
        timeout=120,
    )
    time.sleep(2)
    status = subprocess.run(
        ["systemctl", "is-active", service],
        shell=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    result = {
        "ok": restart.returncode == 0 and status.stdout.strip() == "active",
        "service": service,
        "restart_exit_code": restart.returncode,
        "restart_stdout": restart.stdout[-12000:],
        "restart_stderr": restart.stderr[-12000:],
        "status": status.stdout.strip(),
        "status_stderr": status.stderr[-12000:],
    }
    _audit("service.restart", {"service": service, "ok": result["ok"], "status": result["status"]})
    return result


@router.post("/admin/service/logs")
def admin_service_logs(
    payload: AdminServiceLogsRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    service = _validate_service(payload.service)
    lines = max(1, min(int(payload.lines or 200), 1000))
    result = _run_checked_command(
        ["journalctl", "-u", service, "-n", str(lines), "--no-pager"],
        Path("/tmp"),
        60,
    )
    _audit("service.logs", {"service": service, "lines": lines, "ok": result["ok"]})
    return result


@router.post("/admin/deploy/validate")
def admin_deploy_validate(
    payload: AdminDeployValidateRequest,
    credentials: HTTPAuthorizationCredentials | None = Security(bearerAuth),
):
    _require_admin(credentials)
    cwd = _validate_cwd(payload.cwd)

    results = []
    for cmd in payload.commands:
        tokens = _validate_exec_command(cmd, cwd)
        if tokens[:3] != ["python3", "-m", "py_compile"]:
            raise HTTPException(status_code=403, detail="deploy validate permite apenas python3 -m py_compile")
        results.append(_run_checked_command(tokens, cwd, 120))

    ok = all(item["ok"] for item in results)
    _audit("deploy.validate", {"cwd": str(cwd), "ok": ok, "commands": [item["cmd"] for item in results]})
    return {"ok": ok, "cwd": str(cwd), "results": results}
