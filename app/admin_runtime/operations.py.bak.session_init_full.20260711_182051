    }



@register("continue_session")
def continue_session(req):
    return {
        "ok": True,
        "runtime": {
            "runtime": "agent-runtime-v1",
            "status": "runtime ready",
            "catalog": runtime_catalog(),
        },
        "bootstrap": bootstrap(req),
        "project_memory": project_memory_read(req),
