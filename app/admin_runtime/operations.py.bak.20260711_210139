from pathlib import Path

PROJECT_ROOT = Path("/opt/agente-divina-v2").resolve()


def _resolve_path(p: str) -> Path:
    full = (PROJECT_ROOT / p).resolve()

    if not str(full).startswith(str(PROJECT_ROOT)):
        raise ValueError("Access denied")

    return full


@register("exists")
def exists(req):
    p = _resolve_path(req.get("path"))
    return {
        "ok": True,
        "exists": p.exists(),
        "path": str(p),
    }


@register("list")
def list_files(req):
    p = _resolve_path(req.get("path", "."))

    return {
        "ok": True,
        "items": sorted(x.name for x in p.iterdir())
    }


@register("read")
def read(req):
    p = _resolve_path(req.get("path"))

    return {
        "ok": True,
        "path": str(p),
        "content": p.read_text(encoding="utf-8")
    }


@register("write")
def write(req):
    p = _resolve_path(req.get("path"))

    p.parent.mkdir(parents=True, exist_ok=True)

    p.write_text(
        req.get("content", ""),
        encoding="utf-8"
    )

    return {
        "ok": True,
        "path": str(p)
    }


@register("append")
def append(req):
    p = _resolve_path(req.get("path"))

    with p.open("a", encoding="utf-8") as f:
        f.write(req.get("content", ""))

    return {
        "ok": True,
        "path": str(p)
    }


@register("replace")
def replace(req):
    p = _resolve_path(req.get("path"))

    txt = p.read_text(encoding="utf-8")

    txt = txt.replace(
        req.get("find", ""),
        req.get("replace", "")
    )

    p.write_text(txt, encoding="utf-8")

    return {
        "ok": True,
        "path": str(p)
    }

