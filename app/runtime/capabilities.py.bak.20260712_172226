from app.runtime.registry import register

def service_status(service):
    return {
        "service": service,
        "status": "not_implemented"
    }

def service_restart(service):
    return {
        "service": service,
        "restart": "not_implemented"
    }

def deploy_validate():
    return {
        "validate": "not_implemented"
    }

def deploy_apply():
    return {
        "deploy": "not_implemented"
    }

register("service.status", service_status)
register("service.restart", service_restart)
register("deploy.validate", deploy_validate)
register("deploy.apply", deploy_apply)
