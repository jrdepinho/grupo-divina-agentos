def build_plan(goal: str):
    g = goal.lower()

    if "reinicie" in g or "restart" in g:
        return [
            {
                "action":"service.restart",
                "args":{"service":"agentos"}
            }
        ]

    if "status" in g:
        return [
            {
                "action":"service.status",
                "args":{"service":"agentos"}
            }
        ]

    if "deploy" in g:
        return [
            {"action":"deploy.validate","args":{}},
            {"action":"deploy.apply","args":{}}
        ]

    return [
        {
            "action":"goal.echo",
            "args":{"goal":goal}
        }
    ]
