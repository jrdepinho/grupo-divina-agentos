from .planner import plan
from .dispatcher import execute
from .registry import list_capabilities


def run(
    goal: str,
    mode: str = "execute",
    approval: str = "auto",
    context=None,
):
    execution_plan = plan(goal)

    results = execute(execution_plan)

    return {
        "ok": True,
        "goal": goal,
        "mode": mode,
        "plan": execution_plan,
        "results": results,
        "capabilities": list_capabilities(),
    }
